{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MenuMind",
  "version": "0.1.0",
  "identifier": "com.menumind.operations.app",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MenuMind Cafe Operations",
        "width": 1440,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "MenuMind",
    "shortDescription": "Autonomous cafe operations agent",
    "longDescription": "MenuMind turns restaurant signals into operational recommendations, menu actions, and audit traces."
  }
}
